# Copy to .env and fill in your own credentials. Never commit .env.
# Get your app credentials at https://developers.facebook.com/apps/
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here

# Must match the redirect allowed by your Meta login configuration.
REDIRECT_URI=http://localhost:3000/auth/callback

# Generate your own random session secret.
SESSION_SECRET=change_this_to_a_random_secret_string

PORT=3000
NODE_ENV=development
META_API_VERSION=v26.0
